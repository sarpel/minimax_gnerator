# =============================================================================
# WakeGen TTS Docker Stack - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# Docker Compose automatically reads environment variables from .env
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your preferred settings
#   docker compose --profile full up -d
# =============================================================================

# ---------------------------------------------------------------------------
# GENERAL SETTINGS
# ---------------------------------------------------------------------------

# Compose project name (prefixes container/volume names)
COMPOSE_PROJECT_NAME=wakegen-tts

# ---------------------------------------------------------------------------
# GPU CONFIGURATION
# ---------------------------------------------------------------------------

# Set to 1 to enable GPU support (requires docker-compose.gpu.yml)
# CONCEPT: GPU acceleration significantly speeds up inference for local models.
# Most models are 5-10x faster with GPU.
ENABLE_GPU=0

# ---------------------------------------------------------------------------
# PIPER CONFIGURATION
# ---------------------------------------------------------------------------

# Default voice for Piper TTS
# Format: language_REGION-name-quality
# Examples: en_US-lessac-medium, en_GB-alba-medium, de_DE-thorsten-high
# Full list: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_US-lessac-medium

# ---------------------------------------------------------------------------
# BARK CONFIGURATION
# ---------------------------------------------------------------------------

# Use smaller Bark models (1 = yes, 0 = no)
# CONCEPT: Small models use ~6GB VRAM, full models use ~12GB
# Small models are faster but slightly lower quality
SUNO_USE_SMALL_MODELS=1

# ---------------------------------------------------------------------------
# COQUI XTTS CONFIGURATION
# ---------------------------------------------------------------------------

# Accept Coqui license terms (required)
# IMPORTANT: By setting this to 1, you agree to Coqui's terms of service
COQUI_TOS_AGREED=1

# ---------------------------------------------------------------------------
# ORPHEUS CONFIGURATION
# ---------------------------------------------------------------------------

# Model size: small, medium, large
# CONCEPT: Larger models produce higher quality but need more VRAM
# - small: ~2GB VRAM, fast inference
# - medium: ~4GB VRAM, balanced
# - large: ~8GB VRAM, highest quality
MODEL_SIZE=small

# ---------------------------------------------------------------------------
# OUTPUT CONFIGURATION
# ---------------------------------------------------------------------------

# Base path for generated audio files
# Each provider has its own subdirectory
OUTPUT_PATH=./outputs

# ---------------------------------------------------------------------------
# MODEL CACHE CONFIGURATION
# ---------------------------------------------------------------------------

# Path for caching downloaded models
# Models can be several GB, so this should be on a drive with enough space
MODEL_CACHE_PATH=./models
