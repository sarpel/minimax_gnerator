# Auto-detect text files and perform LF normalization
* text=auto

# Force LF line endings for Python files
*.py text eol=lf

# Force LF for other source files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
